# ============================================================================
# Individual variation in vulture use of an anthrax outbreak
# Reproducible analysis: visitation, unique bird-day biomass removal,
# benchmark sensitivity analyses, and gross/edible biomass figures.
#
# Primary analysis: 100% gross carcass biomass.
# Sensitivity analysis: 55% edible carcass biomass (Houston 1979 assumption).
#
# REQUIRED INPUTS: Edit the placeholder filenames in the INPUT FILES section.
# Do not include restricted wildlife telemetry in a public code repository.
#
# RUN (from the project directory):
#   Rscript Vulture_Anthrax_Analysis.R
# Or specify data and output directories:
#   Rscript Vulture_Anthrax_Analysis.R /path/to/data /path/to/outputs
#
# Packages: dplyr, tidyr, sf, readr, lubridate, ggplot2, scales.
# ============================================================================

library(dplyr)
library(sf)
library(readr)
library(lubridate)
library(tidyr)
library(ggplot2)
library(scales)

args <- commandArgs(trailingOnly = TRUE)
DATA_DIR <- if (length(args) >= 1L) args[[1L]] else "data"
DATADIR <- if (length(args) >= 2L) args[[2L]] else "outputs"
dir.create(DATADIR, recursive = TRUE, showWarnings = FALSE)

WINDOW_START <- as.Date("2017-08-17")
WINDOW_END   <- as.Date("2017-11-27")
D <- as.integer(WINDOW_END - WINDOW_START) + 1L
stopifnot(D == 103L)
EXCLUDE_BIRDS <- c(163113)

# Model assumptions; hippo body masses are scenario inputs, not measured masses.
M_low <- 1386.0
M_mid <- 1461.0
M_high <- 1536.0
U_low <- 0.315
U_mid <- 0.500
U_high <- 1.000
BONE_FRACTION <- 0.45
EDIBLE_FRACTION <- 1 - BONE_FRACTION

# ============================================================================
# 1. GPS FIX ASSIGNMENT AND POOL VISITATION
# ============================================================================
pool_letter_map <- tibble(
  hippo_pool = c(1, 3, 4, 2, 5, 10, 8, 9, 6, 7),
  pool_letter = LETTERS[1:10]
) %>%
  mutate(pool_label = if_else(pool_letter %in% c("A", "B"),
                              "A/B", pool_letter))

# INPUT FILES: Replace these placeholders with your locally available filenames.
# Expected CSV column names are described in README.md.
POOL_INPUT_FILENAME <- "YOUR_HIPPO_CARCASS_DATA.csv"
GPS_INPUT_FILENAME  <- "YOUR_VULTURE_GPS_DATA.csv"

pool_file <- file.path(DATA_DIR, POOL_INPUT_FILENAME)
gps_file  <- file.path(DATA_DIR, GPS_INPUT_FILENAME)
if (!file.exists(pool_file)) stop("Missing hippo pool input: ", pool_file)
if (!file.exists(gps_file)) stop("Missing GPS input (not bundled with public code): ", gps_file)

hippo_pools <- read_csv(pool_file, show_col_types = FALSE) %>%
  filter(!is.na(utm_x), !is.na(utm_y)) %>%
  transmute(
    hippo_pool = hippo_pool,
    pool_utm_x = utm_x,
    pool_utm_y = utm_y,
    total_dead = total_dead
  ) %>%
  left_join(pool_letter_map, by = "hippo_pool")
stopifnot(nrow(hippo_pools) == 10,
          n_distinct(hippo_pools$hippo_pool) == 10,
          !anyNA(hippo_pools$pool_label),
          sum(hippo_pools$total_dead) == 67)

raw_gps <- read_csv(gps_file, show_col_types = FALSE)
if (!inherits(raw_gps$timestamp, "POSIXct")) {
  raw_gps <- raw_gps %>%
    mutate(timestamp = as.POSIXct(timestamp, tz = "UTC"))
}
stopifnot(!anyNA(raw_gps$timestamp))

vulture_df_raw <- raw_gps %>%
  mutate(
    timestamp_local = with_tz(timestamp, "Africa/Dar_es_Salaam"),
    hour_local = hour(timestamp_local),
    date_local = as.Date(timestamp_local)
  ) %>%
  filter(
    !`tag-local-identifier` %in% EXCLUDE_BIRDS,
    hour_local >= 7, hour_local <= 16,
    date_local >= WINDOW_START, date_local <= WINDOW_END,
    !is.na(`location-long`), !is.na(`location-lat`)
  ) %>%
  mutate(gps_fix_id = row_number())

vulture_sf <- st_as_sf(
  vulture_df_raw,
  coords = c("location-long", "location-lat"),
  crs = 4326,
  remove = FALSE
) %>% st_transform(32736)
coords <- st_coordinates(vulture_sf)

vulture_df <- tibble(
  gps_fix_id = vulture_df_raw$gps_fix_id,
  bird_id = vulture_df_raw$`tag-local-identifier`,
  date = vulture_df_raw$date_local,
  time = vulture_df_raw$hour_local,
  utm_x = coords[, 1],
  utm_y = coords[, 2]
)
stopifnot(n_distinct(vulture_df$bird_id) == 7L)

# Assign each raw GPS fix to a single nearest pool if within 500 m.
# A and B remain distinct candidates, then combine for summaries.
results <- bind_rows(lapply(seq_len(nrow(hippo_pools)), function(i) {
  vulture_df %>%
    mutate(
      hippo_pool = hippo_pools$hippo_pool[i],
      total_dead = hippo_pools$total_dead[i],
      dist_m = sqrt((utm_x - hippo_pools$pool_utm_x[i])^2 +
                    (utm_y - hippo_pools$pool_utm_y[i])^2)
    )
})) %>%
  left_join(pool_letter_map, by = "hippo_pool") %>%
  arrange(gps_fix_id, dist_m, hippo_pool) %>%
  group_by(gps_fix_id) %>%
  mutate(
    within_500m = dist_m <= 500,
    visit_pool = row_number() == 1L & within_500m
  ) %>%
  ungroup()
stopifnot(nrow(results) == nrow(vulture_df) * nrow(hippo_pools),
          all(results %>% group_by(gps_fix_id) %>%
                summarise(n_assigned = sum(visit_pool), .groups = "drop") %>%
                pull(n_assigned) <= 1L))

# Visitation statistic: one count per bird x pool x date.
bird_pool_binary <- results %>%
  group_by(bird_id, pool_label) %>%
  summarise(
    visited_500m = as.integer(any(visit_pool)),
    n_fixes_500m = sum(visit_pool),
    n_days_500m = n_distinct(date[visit_pool]),
    .groups = "drop"
  ) %>%
  left_join(hippo_pools %>%
              group_by(pool_label) %>%
              summarise(total_dead = sum(total_dead), .groups = "drop"),
            by = "pool_label")

bird_pool_binary_10pool <- results %>%
  group_by(bird_id, hippo_pool, pool_letter, total_dead) %>%
  summarise(
    visited_500m = as.integer(any(visit_pool)),
    n_fixes_500m = sum(visit_pool),
    n_days_500m = n_distinct(date[visit_pool]),
    .groups = "drop"
  )

# Descriptive pool-bird visit-days may exceed unique bird-calendar-days.
bird_summary <- bird_pool_binary %>%
  group_by(bird_id) %>%
  summarise(
    visit_location_counts = sum(n_fixes_500m),
    pool_bird_visit_days = sum(n_days_500m),
    n_unique_pools_visited = sum(visited_500m),
    pools_visited = paste(sort(pool_label[visited_500m == 1]), collapse = ", "),
    .groups = "drop"
  )

pool_use_stats <- bird_pool_binary %>%
  group_by(pool_label, total_dead) %>%
  summarise(
    pool_visit_days = sum(n_days_500m),
    pool_visit_locations = sum(n_fixes_500m),
    n_birds_visiting = sum(visited_500m),
    .groups = "drop"
  ) %>% arrange(pool_label)

if (sum(pool_use_stats$pool_visit_days) != 114L ||
    sum(pool_use_stats$pool_visit_locations) != 336L) {
  warning("2017 visitation differs from reference output (114 pool-bird-days / 336 fixes). Check data input.")
}

cor_dead_vs_days <- cor.test(pool_use_stats$total_dead,
                             pool_use_stats$pool_visit_days,
                             method = "spearman", exact = FALSE)
cor_dead_vs_locs <- cor.test(pool_use_stats$total_dead,
                             pool_use_stats$pool_visit_locations,
                             method = "spearman", exact = FALSE)
write_csv(bird_pool_binary, file.path(DATADIR, "bird_pool_visitation_9pool.csv"))
write_csv(bird_pool_binary_10pool, file.path(DATADIR, "bird_pool_visitation_10pool.csv"))
write_csv(pool_use_stats, file.path(DATADIR, "pool_use_vs_carcass.csv"))


# ============================================================================
# 2. UNIQUE BIRD-DAY ALLOCATION AND BIOMASS MODEL
# ============================================================================

daily_pool_fixes <- results %>%
  filter(visit_pool) %>%
  count(bird_id, date, pool_label, name = "n_fixes_at_pool") %>%
  group_by(bird_id, date) %>%
  mutate(
    n_pools_that_day = n(),
    fix_share = n_fixes_at_pool / sum(n_fixes_at_pool),
    removal_low  = U_low * fix_share,
    removal_mid  = U_mid * fix_share,
    removal_high = U_high * fix_share
  ) %>% ungroup()

bird_day_audit <- daily_pool_fixes %>%
  distinct(bird_id, date, n_pools_that_day) %>%
  summarise(
    unique_bird_days = n(),
    pool_bird_days = sum(n_pools_that_day),
    multi_pool_bird_days = sum(n_pools_that_day > 1L),
    excess_pool_days = sum(n_pools_that_day - 1L)
  )
if (bird_day_audit$unique_bird_days != 112L ||
    bird_day_audit$pool_bird_days != 114L) {
  warning("Active bird-calendar-days or pool-bird-days differ from the validated reference (112 / 114).")
}
# Check actual one-intake-per-bird-day allocation.
check_daily <- daily_pool_fixes %>%
  group_by(bird_id, date) %>%
  summarise(fix_share_sum = sum(fix_share),
            removal_low_sum = sum(removal_low),
            removal_mid_sum = sum(removal_mid),
            removal_high_sum = sum(removal_high), .groups = "drop")
stopifnot(all(abs(check_daily$fix_share_sum - 1) < 1e-10),
          all(abs(check_daily$removal_low_sum - U_low) < 1e-10),
          all(abs(check_daily$removal_mid_sum - U_mid) < 1e-10),
          all(abs(check_daily$removal_high_sum - U_high) < 1e-10),
          sum(pool_use_stats$pool_visit_days) == bird_day_audit$pool_bird_days)

# Retain descriptive pool-bird visit-days separately;
# unique calendar days govern the biomass model and its archetypes.
bird_unique_days <- daily_pool_fixes %>%
  distinct(bird_id, date) %>%
  count(bird_id, name = "unique_active_days")

bird_summary_model <- bird_summary %>%
  left_join(bird_unique_days, by = "bird_id") %>%
  mutate(
    unique_active_days = coalesce(unique_active_days, 0L),
    archetype = case_when(
      unique_active_days >= 25L ~ "Super user",
      unique_active_days >= 8L ~ "Moderate user",
      unique_active_days >= 1L ~ "Limited user",
      TRUE ~ "Non user"
    )
  ) %>% arrange(desc(unique_active_days))

bird_pool_removal <- daily_pool_fixes %>%
  group_by(bird_id, pool_label) %>%
  summarise(
    pool_visit_days = n(),
    n_fixes_500m = sum(n_fixes_at_pool),
    removal_low = sum(removal_low),
    removal_mid = sum(removal_mid),
    removal_high = sum(removal_high),
    .groups = "drop"
  )

# Pool count x weights, with 45% discount only for sensitivity.
pool_biomass <- hippo_pools %>%
  group_by(pool_label) %>%
  summarise(total_dead = sum(total_dead), .groups = "drop") %>%
  mutate(
    biomass_low = total_dead * M_low,
    biomass_mid = total_dead * M_mid,
    biomass_high = total_dead * M_high,
    edible_low = biomass_low * EDIBLE_FRACTION,
    edible_mid = biomass_mid * EDIBLE_FRACTION,
    edible_high = biomass_high * EDIBLE_FRACTION
  )

pool_removal_total <- bird_pool_removal %>%
  group_by(pool_label) %>%
  summarise(
    total_removal_low = sum(removal_low),
    total_removal_mid = sum(removal_mid),
    total_removal_high = sum(removal_high),
    .groups = "drop"
  )

pool_q1_summary <- pool_biomass %>%
  left_join(pool_removal_total, by = "pool_label") %>%
  mutate(
    across(starts_with("total_removal"), ~ replace_na(.x, 0)),
    remaining_low = pmax(0, biomass_low - total_removal_low),
    remaining_mid = pmax(0, biomass_mid - total_removal_mid),
    remaining_high = pmax(0, biomass_high - total_removal_high)
  )

bird_archetype_removal <- bird_summary_model %>%
  mutate(
    removal_low_kg = unique_active_days * U_low,
    removal_mid_kg = unique_active_days * U_mid,
    removal_high_kg = unique_active_days * U_high
  )

# Mean days must NOT be rounded before the projection.
archetype_summary_model <- bird_archetype_removal %>%
  group_by(archetype) %>%
  summarise(
    n_birds = n(),
    mean_days_active = mean(unique_active_days),
    mean_visit_locations = mean(visit_location_counts),
    mean_removal_low_kg = mean(removal_low_kg),
    mean_removal_mid_kg = mean(removal_mid_kg),
    mean_removal_high_kg = mean(removal_high_kg),
    total_removal_low_kg = sum(removal_low_kg),
    total_removal_mid_kg = sum(removal_mid_kg),
    total_removal_high_kg = sum(removal_high_kg),
    .groups = "drop"
  )

# Independent cross-check: all bird allocations equal the model totals.
stopifnot(
  abs(sum(pool_q1_summary$total_removal_mid) -
        sum(bird_archetype_removal$removal_mid_kg)) < 1e-8,
  abs(sum(pool_q1_summary$total_removal_mid) -
        nrow(check_daily) * U_mid) < 1e-8,
  sum(pool_biomass$total_dead) == 67
)

write_csv(daily_pool_fixes, file.path(DATADIR, "daily_pool_fix_allocation.csv"))
write_csv(bird_summary_model, file.path(DATADIR, "bird_summary_unique_days.csv"))
write_csv(bird_pool_removal, file.path(DATADIR, "bird_pool_removal.csv"))
write_csv(pool_biomass, file.path(DATADIR, "Table_S1_pool_gross_edible.csv"))
write_csv(pool_q1_summary, file.path(DATADIR, "pool_biomass_removal.csv"))
write_csv(archetype_summary_model, file.path(DATADIR, "archetype_summary.csv"))


# ============================================================================
# 3. INDIVIDUAL REMOVAL AND ARCHETYPE COMPARISON
# ============================================================================

B_low <- sum(pool_biomass$biomass_low)
B_mid <- sum(pool_biomass$biomass_mid)
B_high <- sum(pool_biomass$biomass_high)

bird_q3 <- bird_archetype_removal %>%
  transmute(
    bird_id,
    bird_type = paste0("Bird ", bird_id),
    archetype,
    visit_location_counts,
    pool_bird_visit_days,
    unique_active_days,
    n_unique_pools_visited,
    pools_visited,
    pct_days_active = 100 * unique_active_days / D,
    total_removal_low_kg = removal_low_kg,
    total_removal_mid_kg = removal_mid_kg,
    total_removal_high_kg = removal_high_kg,
    pct_biomass_removed_mid = 100 * removal_mid_kg / B_mid,
    is_hypothetical = FALSE
  )

# The hypothetical user is a mathematical upper bound, not an observed bird.
hypothetical_daily <- tibble(
  bird_id = NA_real_,
  bird_type = "Hypothetical daily user",
  archetype = "Hypothetical daily user",
  visit_location_counts = NA_integer_,
  pool_bird_visit_days = NA_integer_,
  unique_active_days = D,
  n_unique_pools_visited = NA_integer_,
  pools_visited = NA_character_,
  pct_days_active = 100,
  total_removal_low_kg = D * U_low,
  total_removal_mid_kg = D * U_mid,
  total_removal_high_kg = D * U_high,
  pct_biomass_removed_mid = 100 * D * U_mid / B_mid,
  is_hypothetical = TRUE
)

bird_q3_full <- bind_rows(bird_q3, hypothetical_daily)
# Mean per-bird removal ratio used in the Abstract and Discussion.
comparison <- archetype_summary_model %>%
  filter(archetype %in% c("Super user", "Moderate user")) %>%
  select(archetype, mean_days_active, mean_removal_mid_kg)
super_kg <- comparison$mean_removal_mid_kg[comparison$archetype == "Super user"]
moderate_kg <- comparison$mean_removal_mid_kg[comparison$archetype == "Moderate user"]
stopifnot(length(super_kg) == 1, length(moderate_kg) == 1, moderate_kg > 0)

write_csv(bird_q3_full, file.path(DATADIR, "bird_modeled_removal.csv"))


# ============================================================================
# 4. BIOMASS / INTAKE SENSITIVITY GRIDS (S2 AND S3)
# ============================================================================

biomass_scenarios <- tibble(
  biomass_scenario = c("High", "Mid", "Low"),
  hippo_mass_kg = c(M_high, M_mid, M_low),
  gross_biomass_kg = c(sum(pool_biomass$biomass_high),
                       sum(pool_biomass$biomass_mid),
                       sum(pool_biomass$biomass_low))
)
intake_scenarios <- tibble(
  intake_scenario = c("High", "Mid", "Low"),
  intake_rate_kg = c(U_high, U_mid, U_low)
)
thresholds <- tibble(threshold_pct = c(20, 50, 80))

archetype_days <- archetype_summary_model %>%
  filter(archetype %in% c("Super user", "Moderate user")) %>%
  select(archetype, mean_days_active) %>%
  bind_rows(tibble(archetype = "Hypothetical daily user",
                   mean_days_active = as.numeric(D)))

make_benchmark <- function(edible = FALSE) {
  fraction <- if (edible) EDIBLE_FRACTION else 1
  archetype_days %>%
    cross_join(biomass_scenarios) %>%
    cross_join(intake_scenarios) %>%
    cross_join(thresholds) %>%
    mutate(
      biomass_basis = if (edible) "Edible" else "Gross",
      total_biomass_kg = gross_biomass_kg * fraction,
      target_removal_kg = total_biomass_kg * threshold_pct / 100,
      removal_per_bird_kg = mean_days_active * intake_rate_kg,
      n_vultures_needed = ceiling(target_removal_kg / removal_per_bird_kg)
    ) %>%
    select(biomass_basis, archetype, mean_days_active,
           biomass_scenario, hippo_mass_kg, total_biomass_kg,
           intake_scenario, intake_rate_kg, threshold_pct,
           target_removal_kg, removal_per_bird_kg, n_vultures_needed) %>%
    arrange(archetype, threshold_pct, desc(hippo_mass_kg),
            desc(intake_rate_kg))
}

S2_gross <- make_benchmark(FALSE)
S3_edible <- make_benchmark(TRUE)
stopifnot(nrow(S2_gross) == 81L, nrow(S3_edible) == 81L,
          all(S2_gross$n_vultures_needed * S2_gross$removal_per_bird_kg >=
                S2_gross$target_removal_kg - 1e-8),
          all(S3_edible$n_vultures_needed * S3_edible$removal_per_bird_kg >=
                S3_edible$target_removal_kg - 1e-8))



# ============================================================================
# 5. FINAL FIGURES: GROSS PRIMARY AND EDIBLE SENSITIVITY
# These figures use the same unrounded archetype means as Tables S2 and S3.
# Limited users are shown in figures but excluded from S2/S3, as in .
# ============================================================================

B_gross  <- sum(pool_biomass$biomass_mid)
B_edible <- B_gross * EDIBLE_FRACTION

figure_archetypes <- archetype_summary_model %>%
  select(archetype, mean_days_active) %>%
  bind_rows(
    tibble(archetype = "Hypothetical daily user",
           mean_days_active = as.numeric(D))
  )

archetype_order <- c(
  "Limited user", "Moderate user", "Super user", "Hypothetical daily user"
)

archetype_labels <- c(
  "Hypothetical daily user" = "Hypothetical\ndaily user",
  "Super user" = "Super user",
  "Moderate user" = "Moderate user",
  "Limited user" = "Limited user"
)

arch_colors <- c(
  "Hypothetical daily user" = "#CC79A7",
  "Super user" = "#E69F00",
  "Moderate user" = "#009E73",
  "Limited user" = "#0072B2"
)

stopifnot(
  nrow(figure_archetypes) == 4L,
  setequal(figure_archetypes$archetype, archetype_order),
  all(figure_archetypes$mean_days_active > 0)
)

make_biomass_figure <- function(total_biomass, biomass_type, filename) {
  plot_data <- figure_archetypes %>%
    crossing(threshold_pct = c(20, 50, 80)) %>%
    mutate(
      target_removal_kg = total_biomass * threshold_pct / 100,
      removal_per_bird_kg = mean_days_active * U_mid,
      n_vultures_needed = ceiling(target_removal_kg / removal_per_bird_kg),
      archetype = factor(archetype, levels = archetype_order),
      threshold_label = factor(paste0(threshold_pct, "%"),
                               levels = c("20%", "50%", "80%"))
    )

  output_table <- plot_data %>%
    mutate(
      archetype = as.character(archetype),
      threshold = paste0(threshold_pct, "% removal")
    ) %>%
    select(archetype, threshold, n_vultures_needed) %>%
    pivot_wider(names_from = threshold, values_from = n_vultures_needed) %>%
    arrange(match(archetype, rev(archetype_order)))

  threshold_labels <- setNames(
    paste0(
      c("20%", "50%", "80%"), " removal\n(~",
      scales::comma(total_biomass * c(0.20, 0.50, 0.80), accuracy = 1),
      " kg)"
    ),
    c("20%", "50%", "80%")
  )

  figure_title <- if (biomass_type == "Gross") {
    "Vultures required to reach gross biomass removal thresholds (100%)"
  } else {
    "Vultures required to reach edible biomass removal thresholds (55%; Houston 1979)"
  }

  subtitle_text <- paste0(
    biomass_type, " carcass biomass (~",
    scales::comma(round(total_biomass)), " kg)  |  ",
    D, "-day outbreak window"
  )

  p <- ggplot(
    plot_data,
    aes(x = archetype, y = n_vultures_needed, fill = archetype)
  ) +
    geom_col(width = 0.55, alpha = 0.92) +
    geom_text(
      aes(label = scales::comma(n_vultures_needed)),
      hjust = -0.15, size = 3.6, fontface = "bold", color = "grey15"
    ) +
    coord_flip(clip = "off") +
    facet_wrap(
      ~threshold_label,
      ncol = 3,
      labeller = as_labeller(threshold_labels),
      scales = "free_x"
    ) +
    scale_x_discrete(labels = archetype_labels) +
    scale_y_continuous(
      labels = scales::comma,
      expand = expansion(mult = c(0, 0.35)),
      breaks = scales::breaks_pretty(n = 3)
    ) +
    scale_fill_manual(values = arch_colors) +
    labs(title = figure_title, subtitle = subtitle_text,
         x = NULL, y = "Vultures needed") +
    theme_minimal(base_size = 12) +
    theme(
      plot.title = element_text(
        face = "bold", size = 13.5, margin = margin(b = 5)
      ),
      plot.subtitle = element_text(
        size = 9, color = "grey35", margin = margin(b = 14)
      ),
      plot.background = element_rect(fill = "white", color = NA),
      plot.margin = margin(15, 35, 15, 15),
      strip.text = element_text(face = "bold", size = 10.5),
      strip.background = element_rect(fill = "#F0F0F0", color = NA),
      panel.grid.major.y = element_blank(),
      panel.grid.minor = element_blank(),
      panel.grid.major.x = element_line(color = "grey90", linewidth = 0.45),
      panel.spacing = grid::unit(2.3, "lines"),
      axis.text.y = element_text(size = 10, color = "grey20"),
      axis.text.x = element_text(
        size = 8, color = "grey45", angle = 30, hjust = 1
      ),
      legend.position = "none"
    )

  ggsave(file.path(DATADIR, paste0(filename, ".png")),
         plot = p, width = 15, height = 6, dpi = 300, bg = "white")
  ggsave(file.path(DATADIR, paste0(filename, ".pdf")),
         plot = p, width = 15, height = 6, bg = "white")
  write_csv(output_table, file.path(DATADIR, paste0(filename, "_table.csv")))
  write_csv(plot_data, file.path(DATADIR, paste0(filename, "_plot_data.csv")))
  invisible(list(figure = p, table = output_table, data = plot_data))
}

